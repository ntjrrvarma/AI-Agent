# Copy to .env and adjust.
PRIMARY_PROVIDER=local

# OpenAI-compatible server (LM Studio default: http://127.0.0.1:1234/v1)
OPENAI_BASE_URL=http://127.0.0.1:1234
OPENAI_API_KEY=lm-studio
LOCAL_MODEL=qwen3.5-4b

# Gemini (when PRIMARY_PROVIDER=gemini or after `use gemini`)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Memory
DATABASE_PATH=
SKILLS_DIR=
RECENT_MESSAGES_LIMIT=40
SUMMARIZE_EVERY_N_MESSAGES=30

# Optional
AGENT_NAME=Assistant
SYSTEM_PROMPT=
CONVERSATION_ID=
